# Copy this file to .env and fill in real values. Never commit .env.

# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/umuryangoremezo

# Server port
PORT=2350

# JWT signing secret — use a long random string in production
JWT_SECRET=change-me-to-a-long-random-secret

# Cloudinary credentials
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=event-reports

# Comma-separated allowed CORS origins (frontend URLs)
CLIENT_ORIGINS=http://localhost:5173,https://your-frontend.example.com

# Minimum attendance percentage for a member to be considered active
ATTENDANCE_THRESHOLD=30

# Environment: development | production
NODE_ENV=development
